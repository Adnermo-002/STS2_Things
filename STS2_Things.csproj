<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <!-- Build with /p:Sts2TargetVersion=v107.1 for the stable implementation. -->
    <Sts2TargetVersion Condition="'$(Sts2TargetVersion)' == ''">v111</Sts2TargetVersion>
    <AssemblyName>STS2_Things</AssemblyName>
    <Version>1.10.0</Version>
    <RootNamespace>STS2_Things</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <DefineConstants Condition="'$(Sts2TargetVersion)' == 'v107.1'">$(DefineConstants);STS2_V107_1</DefineConstants>
    <DefineConstants Condition="'$(Sts2TargetVersion)' == 'v111'">$(DefineConstants);STS2_V111</DefineConstants>

    <!-- Override with /p:Sts2GameDir=... or the STS2_GAME_DIR environment variable. -->
    <Sts2GameDir Condition="'$(Sts2GameDir)' == '' and '$(STS2_GAME_DIR)' != ''">$(STS2_GAME_DIR)</Sts2GameDir>
    <Sts2GameDir Condition="'$(Sts2GameDir)' == ''">D:\Steam\steamapps\common\Slay the Spire 2</Sts2GameDir>
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2GameDir)\data_sts2_windows_x86_64</Sts2DataDir>
    <ModInstallDir Condition="'$(ModInstallDir)' == ''">$(Sts2GameDir)\mods\STS2_Things</ModInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="bootstrap\**\*.cs" />
    <Compile Remove="build\**\*.cs" />
    <Compile Remove=".tmp\**\*.cs" />
    <Compile Remove="tmp\**\*.cs" />
    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
      <!-- Keep editor/runtime probes loadable under Godot's isolated .NET
           AssemblyLoadContext. Packaging copies only the three declared mod
           artifacts, so these target-owned references never enter the mod. -->
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateSts2References" BeforeTargets="ResolveReferences">
    <Error Condition="'$(Sts2TargetVersion)' != 'v107.1' and '$(Sts2TargetVersion)' != 'v111'"
           Text="Unsupported Sts2TargetVersion '$(Sts2TargetVersion)'. Use v107.1 or v111." />
    <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')"
           Text="STS2 $(Sts2TargetVersion) assembly not found at '$(Sts2DataDir)\sts2.dll'. Set Sts2DataDir, Sts2GameDir, or STS2_GAME_DIR." />
    <Error Condition="!Exists('$(Sts2DataDir)\0Harmony.dll')"
           Text="Harmony assembly not found at '$(Sts2DataDir)\0Harmony.dll'. Set Sts2GameDir or STS2_GAME_DIR." />
  </Target>

  <Target Name="InstallModDll" AfterTargets="Build" Condition="'$(InstallMod)' == 'true'">
    <MakeDir Directories="$(ModInstallDir)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(ModInstallDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          DestinationFolder="$(ModInstallDir)"
          SkipUnchangedFiles="true"
          Condition="'$(Configuration)' == 'Debug' and Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>
</Project>
